# Variáveis lidas pelo docker-compose.yml (este arquivo fica na RAIZ do
# projeto, não em server/). Copie para .env e preencha:
#
#   cp .env.example .env
#
# O .env da raiz é ignorado pelo git — cada máquina tem o seu. É por isso que,
# ao clonar ou dar pull numa máquina nova, o chat vem desligado até você
# preencher ANTHROPIC_API_KEY aqui.
#
# Para rodar em modo desenvolvimento (npm run dev), quem vale é server/.env.

# Segredo para assinar os tokens JWT. OBRIGATÓRIO — o compose recusa subir sem.
# Gere um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chave da API da Anthropic (https://console.anthropic.com/).
# Vazia = campo de chat some do app; o resto funciona normalmente.
ANTHROPIC_API_KEY=

# Bot do Telegram (opcional). Vazio = integração desligada.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Origem permitida no CORS. O nginx do container do client faz proxy de /api,
# então o padrão * serve para o acesso pela rede local e pelo Tailscale.
CORS_ORIGIN=*

# Fuso do container E do app. Sem isso o container roda em UTC e "hoje" vira o
# dia seguinte às 21h no horário de Brasília.
APP_TZ=America/Sao_Paulo

# Conta criada sozinha na primeira execução (o app não tem tela de login).
DEFAULT_USER_NAME=Rafael
DEFAULT_USER_EMAIL=eu@orbit.local

# Quem enxerga o app na porta 8080. O padrão 0.0.0.0 aceita qualquer interface
# (rede local + Tailscale) — é o que faz o acesso pelo celular funcionar.
# Como o app entra sem senha, quem alcança essa porta entra na sua conta.
# Para restringir ao Tailscale, use o IP de `tailscale ip -4`; para só esta
# máquina, 127.0.0.1.
BIND_ADDR=0.0.0.0
