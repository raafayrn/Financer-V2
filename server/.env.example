# Porta do servidor HTTP
PORT=4000

# Banco de dados (SQLite por padrão). Para Postgres, troque o provider no
# schema.prisma para "postgresql" e use uma URL como:
# postgresql://user:senha@localhost:5432/controle_financeiro
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT. GERE UM VALOR ALEATÓRIO E LONGO.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Validade do token (formato aceito pelo jsonwebtoken, ex.: 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# Chave da API da Anthropic (fica SOMENTE no backend, nunca no frontend).
# Obtenha em https://console.anthropic.com/
# Sem ela, o lançamento por chat em linguagem natural (e o bot do Telegram)
# fica desabilitado.
ANTHROPIC_API_KEY=

# Origem permitida para CORS (URL do frontend). Use * apenas em desenvolvimento.
CORS_ORIGIN=http://localhost:5173

# Token do bot do Telegram (crie um com @BotFather no Telegram).
# Sem ele, a integração com o Telegram fica desabilitada.
TELEGRAM_BOT_TOKEN=

# Username do bot (sem @, ex.: MeuControleFinanceiroBot) — usado só para
# montar o link/instrução exibidos na tela de pareamento no app.
TELEGRAM_BOT_USERNAME=

# Fuso do usuário: define o que o backend considera "hoje" (água do dia,
# treino de hoje, provas futuras, data enviada ao Claude). NÃO depende do
# relógio do processo — o container Docker roda em UTC e, sem isso, o dia
# virava às 21h no horário de Brasília.
APP_TZ=America/Sao_Paulo

# O app NÃO tem tela de login: entra sozinho na conta do dono e cria essa
# conta na primeira execução (POST /api/auth/auto). Nome e e-mail usados nessa
# criação — o e-mail é só identificador interno, não precisa ser real.
# Consequência: quem alcança a porta da API entra na sua conta. Não publique
# a API na internet aberta; mantenha em rede local ou VPN pessoal (Tailscale).
DEFAULT_USER_NAME=Rafael
DEFAULT_USER_EMAIL=eu@orbit.local

# Desliga a validação de certificado TLS nas chamadas de saída (Anthropic,
# Telegram). Só para dev atrás de proxy corporativo com certificado
# auto-assinado. É ignorado quando NODE_ENV=production.
# ALLOW_INSECURE_TLS=0

# Avisos proativos do bot (o app te procura, em vez de esperar você abrir).
# Só funcionam com TELEGRAM_BOT_TOKEN configurado e a conta vinculada no app.
# TELEGRAM_NOTIFICATIONS=0 desliga todos de uma vez.
TELEGRAM_NOTIFICATIONS=1
# Resumo da manhã (finanças + contas vencendo + treino + provas). No dia 1 vem
# junto o fechamento do mês anterior. Horário no fuso de APP_TZ.
TELEGRAM_DIGEST_HOUR=08:00
# Lembrete de água — só sai se a meta do dia ainda não tiver sido batida.
TELEGRAM_WATER_HOUR=20:00
