# Dependencies
node_modules/

# Build output
dist/
build/
# Service Worker gerado pelo vite-plugin-pwa em desenvolvimento
client/dev-dist/

# Environment
.env
*.local

# Database (SQLite)
*.db
*.db-journal
server/prisma/*.db
server/prisma/*.db-journal
server/test/test.db
server/test/test.db-journal

# Backups locais do banco (gerados por scripts/backup-db.ps1)
/backups/

# Ícone do atalho de área de trabalho (gerado por scripts/generate-ico.ps1)
/Financer.ico

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test coverage
coverage/

# TypeScript build cache
*.tsbuildinfo

# Config do Vite compilado por engano — o fonte é o vite.config.ts. O Vite
# carrega vite.config.js ANTES do .ts, então um arquivo gerado passa a mandar
# no lugar do fonte, silenciosamente. A emissão do tsc -b está redirecionada
# em client/tsconfig.node.json; isto aqui é a segunda barreira.
client/vite.config.js
client/vite.config.d.ts
